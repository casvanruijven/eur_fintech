# Copy to server/.env and fill in. All vars use the ZZPAY_ prefix.

# --- Core ---
ZZPAY_ENVIRONMENT=development
# Generate a long random string, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
ZZPAY_JWT_SECRET=change-me-to-a-long-random-string

# --- Database (matches docker-compose.yml) ---
ZZPAY_POSTGRES_HOST=localhost
ZZPAY_POSTGRES_PORT=5434
ZZPAY_POSTGRES_USER=zzpay
ZZPAY_POSTGRES_PASSWORD=zzpay
ZZPAY_POSTGRES_DB=zzpay

# --- CORS (the Vite dev server) ---
ZZPAY_CORS_ORIGINS=http://localhost:5173

# --- Email ---
# USER is your full Gmail address; PASSWORD is the 16-char Google App Password
# FROM matches the Gmail address.
ZZPAY_SMTP_HOST=
ZZPAY_SMTP_PORT=587
ZZPAY_SMTP_USER=
ZZPAY_SMTP_PASSWORD=
ZZPAY_SMTP_FROM=ZZPay <no-reply@zzpay.nl>
ZZPAY_SMTP_TLS=true
